### Variables
@baseUrl = http://localhost:3004/api/auth
@userUrl = http://localhost:3002/api/users
@token = your_token_will_go_here

### ============================================
### AUTH SERVICE TESTS
### ============================================

### 1. Health Check - Auth Service
GET http://localhost:3004/api/auth

### ============================================
### SIGNUP TESTS
### ============================================

### 2. Signup - Success
POST {{baseUrl}}/signup
Content-Type: application/json

{
  "email": "testuser@example.com",
  "username": "testuser",
  "password": "Test1234",
  "firstName": "Test",
  "lastName": "User"
}

### 3. Signup - Duplicate Email (Should Fail)
POST {{baseUrl}}/signup
Content-Type: application/json

{
  "email": "testuser@example.com",
  "username": "anotheruser",
  "password": "Test1234"
}

### 4. Signup - Duplicate Username (Should Fail)
POST {{baseUrl}}/signup
Content-Type: application/json

{
  "email": "another@example.com",
  "username": "testuser",
  "password": "Test1234"
}

### 5. Signup - Weak Password (Should Fail)
POST {{baseUrl}}/signup
Content-Type: application/json

{
  "email": "weak@example.com",
  "username": "weakpass",
  "password": "weak"
}

### 6. Signup - Invalid Email (Should Fail)
POST {{baseUrl}}/signup
Content-Type: application/json

{
  "email": "notanemail",
  "username": "testuser2",
  "password": "Test1234"
}

### 7. Signup - Missing Fields (Should Fail)
POST {{baseUrl}}/signup
Content-Type: application/json

{
  "email": "test@example.com"
}

### ============================================
### LOGIN TESTS
### ============================================

### 8. Login - Success (SAVE THE TOKEN!)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "Test1234"
}

### 9. Login - Wrong Password (Should Fail)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "WrongPassword"
}

### 10. Login - Non-existent User (Should Fail)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "nonexistent@example.com",
  "password": "Test1234"
}

### 11. Login - Missing Password (Should Fail)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "testuser@example.com"
}

### ============================================
### PROTECTED ROUTES - JWT TEST
### ============================================

### 12. Test Protected Route - With Valid Token
# First login (test 8), copy the token, then paste it in the @token variable at the top
GET {{baseUrl}}/profile
Authorization: Bearer {{token}}

### 13. Test Protected Route - No Token (Should Fail)
GET {{baseUrl}}/profile

### 14. Test Protected Route - Invalid Token (Should Fail)
GET {{baseUrl}}/profile
Authorization: Bearer invalid_token_here

### ============================================
### OAUTH TESTS (Browser Only)
### ============================================

### 15. Login with 42 (Open in Browser)
# GET http://localhost:3004/api/auth/42

### 16. Login with Google (Open in Browser)
# GET http://localhost:3004/api/auth/google

### ============================================
### USER MANAGEMENT SERVICE TESTS
### ============================================

### 17. Health Check - User Management Service
GET {{userUrl}}

### 18. Get Own Profile
GET {{userUrl}}/me
Authorization: Bearer {{token}}

### 19. Get Own Profile - No Token (Should Fail)
GET {{userUrl}}/me

### 20. Get User By ID
GET {{userUrl}}/1
Authorization: Bearer {{token}}

### 21. Get User By ID - Invalid ID (Should Fail)
GET {{userUrl}}/999
Authorization: Bearer {{token}}

### 22. Get User By ID - Not a Number (Should Fail)
GET {{userUrl}}/notanumber
Authorization: Bearer {{token}}

### ============================================
### UPDATE PROFILE TESTS
### ============================================

### 23. Update Profile - Success
PATCH {{userUrl}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Updated",
  "lastName": "Name",
  "bio": "This is my updated bio!"
}

### 24. Update Profile - Just Username
PATCH {{userUrl}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "newusername"
}

### 25. Update Profile - Just Bio
PATCH {{userUrl}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "bio": "Full-stack developer | 42 student | Looking for roommate"
}

### 26. Update Profile - Duplicate Username (Should Fail)
# First create another user, then try to use their username
PATCH {{userUrl}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "younajja"
}

### 27. Update Profile - Username Too Short (Should Fail)
PATCH {{userUrl}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "ab"
}

### 28. Update Profile - Bio Too Long (Should Fail)
PATCH {{userUrl}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "bio": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
}

### ============================================
### CHANGE PASSWORD TESTS
### ============================================

### 29. Change Password - Success
PATCH {{userUrl}}/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "Test1234",
  "newPassword": "NewTest5678"
}

### 30. Change Password - Wrong Current Password (Should Fail)
PATCH {{userUrl}}/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "WrongPassword",
  "newPassword": "NewTest5678"
}

### 31. Change Password - Weak New Password (Should Fail)
PATCH {{userUrl}}/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "NewTest5678",
  "newPassword": "weak"
}

### 32. Login with New Password (After Password Change)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "NewTest5678"
}

### 33. Login with Old Password (Should Fail After Password Change)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "Test1234"
}

### ============================================
### COMPLETE USER FLOW TEST
### ============================================

### 34. Complete Flow - Create User
POST {{baseUrl}}/signup
Content-Type: application/json

{
  "email": "flowtest@example.com",
  "username": "flowtest",
  "password": "Flow1234",
  "firstName": "Flow",
  "lastName": "Test"
}

### 35. Complete Flow - Login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "flowtest@example.com",
  "password": "Flow1234"
}

### 36. Complete Flow - Get Profile
# Copy token from step 35
GET {{userUrl}}/me
Authorization: Bearer YOUR_TOKEN_FROM_STEP_35

### 37. Complete Flow - Update Profile
# Use token from step 35
PATCH {{userUrl}}/profile
Authorization: Bearer YOUR_TOKEN_FROM_STEP_35
Content-Type: application/json

{
  "firstName": "FlowUpdated",
  "bio": "Testing the complete flow!"
}

### 38. Complete Flow - Change Password
# Use token from step 35
PATCH {{userUrl}}/password
Authorization: Bearer YOUR_TOKEN_FROM_STEP_35
Content-Type: application/json

{
  "currentPassword": "Flow1234",
  "newPassword": "NewFlow5678"
}

### 39. Complete Flow - Login with New Password
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "flowtest@example.com",
  "password": "NewFlow5678"
}